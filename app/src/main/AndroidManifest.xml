<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <queries>
        <package android:name="com.sec.android.app.launcher" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.samsung.android.weather" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_WEATHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlurWidgetDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widgets.clock.DigitalClockConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AboutActivity"
            android:exported="false" />
        <activity android:name=".AppearanceSettingsActivity" android:exported="false" />
        <activity
            android:name=".studio.WidgetStudioActivity"
            android:exported="false" />
        <activity android:name=".widgets.extra.OpenAppWidgetConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <activity android:name=".widgets.extra.TextWidgetConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <activity android:name=".widgets.extra.StepCounterConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <activity android:name=".widgets.extra.AlarmWidgetConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <activity android:name=".widgets.extra.CounterConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <activity android:name=".widgets.hydration.HydrationConfigActivity" android:exported="true"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter></activity>
        <service android:name=".widgets.extra.MediaNotificationListener" android:exported="true" android:label="@string/media_player_widget_label" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"><intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter></service>

        <activity android:name="androidx.picker.eyeDropper.SeslEyeDropperActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.snapshotfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/snapshot_file_paths" />
        </provider>

        <receiver
            android:name=".BlurWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_blur" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_supported_cell_size_info" />
        </receiver>

        <receiver
            android:name=".widgets.clock.DigitalClockWidget"
            android:exported="true"
            android:label="@string/digital_clock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_digital_clock" />
        </receiver>

        <receiver
            android:name=".widgets.developer.DeveloperWidgetProvider"
            android:enabled="false"
            android:exported="true"
            android:label="@string/developer_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_developer" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_supported_cell_size_developer_info" />
        </receiver>

        <receiver
            android:name=".studio.production.WidgetPinResultReceiver"
            android:exported="false" />

        <receiver
            android:name=".widgets.battery.BatteryWidget"
            android:exported="true"
            android:label="@string/battery_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_battery" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver
            android:name=".widgets.weather.WeatherWidget"
            android:exported="true"
            android:label="@string/weather_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.blurwidgetdemo.action.OPEN_WEATHER" />
                <action android:name="com.example.blurwidgetdemo.action.REFRESH_WEATHER" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_provider_weather" />
            <meta-data
                android:name="com.sec.android.appwidget.widgetinfo"
                android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver android:name=".widgets.calendar.CalendarWidget" android:exported="true" android:label="@string/calendar_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_calendar" />
            <meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver android:name=".widgets.calendar.CalendarDisplayWidget" android:exported="true" android:label="@string/calendar_display_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_calendar_display" />
            <meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver android:name=".widgets.storage.StorageWidget" android:exported="true" android:label="@string/storage_widget_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_storage" />
            <meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver android:name=".widgets.hydration.HydrationWidget" android:exported="true" android:label="@string/hydration_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.blurwidgetdemo.action.ADD_WATER" />
                <action android:name="com.example.blurwidgetdemo.action.REMOVE_WATER" />
                <action android:name="com.example.blurwidgetdemo.action.RESET_HYDRATION" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_hydration" />
            <meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_adaptive_info" />
        </receiver>

        <receiver android:name=".widgets.extra.GoogleSearchWidget" android:exported="true" android:label="@string/google_search_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_google_search" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_search_info" /></receiver>
        <receiver android:name=".widgets.extra.SamsungBrowserSearchWidget" android:exported="true" android:label="@string/samsung_browser_search_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_google_search" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_search_info" /></receiver>
        <receiver android:name=".widgets.extra.YouTubeSearchWidget" android:exported="true" android:label="@string/youtube_search_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_google_search" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_search_info" /></receiver>
        <receiver android:name=".widgets.extra.OpenAppWidget" android:exported="true" android:label="@string/open_app_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_open_app" /></receiver>
        <receiver android:name=".widgets.extra.ToggleWidget" android:exported="true" android:label="@string/toggle_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="com.example.blurwidgetdemo.action.TOGGLE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_toggle" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_row_info" /></receiver>
        <receiver android:name=".widgets.extra.StepCounterWidget" android:exported="true" android:label="@string/step_counter_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_steps" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_row_info" /></receiver>
        <receiver android:name=".widgets.extra.TextWidget" android:exported="true" android:label="@string/text_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_text" /></receiver>
        <receiver android:name=".widgets.extra.CounterWidget" android:exported="true" android:label="@string/counter_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="com.example.blurwidgetdemo.action.ADD_COUNTER" /><action android:name="com.example.blurwidgetdemo.action.REMOVE_COUNTER" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_counter" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_counter_info" /></receiver>
        <receiver android:name=".widgets.extra.AlarmWidget" android:exported="true" android:label="@string/alarm_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="com.example.blurwidgetdemo.action.TOGGLE_ALARM" /><action android:name="com.example.blurwidgetdemo.action.SNOOZE_ALARM" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_alarm" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_alarm_info" /></receiver>
        <receiver android:name=".widgets.extra.MediaPlayerWidget" android:exported="true" android:label="@string/media_player_widget_label"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /><action android:name="com.example.blurwidgetdemo.action.MEDIA_PREVIOUS" /><action android:name="com.example.blurwidgetdemo.action.MEDIA_TOGGLE" /><action android:name="com.example.blurwidgetdemo.action.MEDIA_NEXT" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_provider_media" /><meta-data android:name="com.sec.android.appwidget.widgetinfo" android:resource="@xml/widget_supported_cell_size_media_info" /></receiver>

        <receiver
            android:name=".LockScreenMessageServiceBoxReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.samsung.android.intent.action.REQUEST_SERVICEBOX_REMOTEVIEWS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".LockScreenMessageSmallWidget"
            android:exported="true"
            android:label="@string/lockscreen_message_1x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lockscreen_message_1x1_widget_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lockscreen_message_1x1_widget_info_oneui" />
        </receiver>

        <receiver
            android:name=".LockScreenMessageWideWidget"
            android:exported="true"
            android:label="@string/lockscreen_message_2x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lockscreen_message_2x1_widget_info" />
            <meta-data
                android:name="samsung.appwidget.monotone.info"
                android:resource="@xml/lockscreen_message_2x1_widget_info_oneui" />
        </receiver>

    </application>
</manifest>
