<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" app:expandable="false" app:expanded="false" app:showNavButtonAsBack="true" app:title="@string/clock_widget_settings">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="10dp">
        <dev.oneuiproject.oneui.widget.Separator android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_preview_section" />
        <FrameLayout android:id="@+id/clock_preview_container" android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/config_preview_bg" android:clipToOutline="true">
            <ImageView android:id="@+id/clock_preview_wallpaper" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            <LinearLayout android:id="@+id/clock_preview_widget" android:layout_width="260dp" android:layout_height="130dp" android:layout_gravity="center" android:background="@drawable/widget_clock_background" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/clock_preview_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Tuesday, August 4" android:textColor="#E6FFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/clock_preview_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="12:45 PM" android:textColor="#FFFFFFFF" android:textSize="38sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <dev.oneuiproject.oneui.widget.Separator android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tint_section" />
                <dev.oneuiproject.oneui.widget.RoundedLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:colorBackground" android:orientation="vertical">
                    <Button android:id="@+id/clock_colour" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_choose_colour" />
                    <RadioGroup android:id="@+id/clock_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/opacity_glass" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Glass" /><RadioButton android:id="@+id/opacity_default" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Default" /><RadioButton android:id="@+id/opacity_solid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Solid" /></RadioGroup>
                    <Switch android:id="@+id/clock_background_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show background" />
                </dev.oneuiproject.oneui.widget.RoundedLinearLayout>
                <dev.oneuiproject.oneui.widget.Separator android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_content" />
                <dev.oneuiproject.oneui.widget.RoundedLinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?android:colorBackground" android:orientation="vertical">
                    <Switch android:id="@+id/clock_show_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_show_date" /><Switch android:id="@+id/clock_show_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_show_day" /><Switch android:id="@+id/clock_date_above" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Date above time" /><Switch android:id="@+id/clock_show_phone_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show phone battery" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Tap action" /><Spinner android:id="@+id/clock_tap_action" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Clock font" /><Spinner android:id="@+id/clock_font" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/clock_text_scale_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="Text size: 100%" /><SeekBar android:id="@+id/clock_text_scale" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />
                </dev.oneuiproject.oneui.widget.RoundedLinearLayout>
                <dev.oneuiproject.oneui.widget.Separator android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_time_format" />
                <RadioGroup android:id="@+id/clock_time_format" android:layout_width="match_parent" android:layout_height="wrap_content"><RadioButton android:id="@+id/format_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_system_format" /><RadioButton android:id="@+id/format_12" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_force_12" /><RadioButton android:id="@+id/format_24" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_force_24" /></RadioGroup>
                <RadioGroup android:id="@+id/clock_alignment" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/align_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/clock_align_start" /><RadioButton android:id="@+id/align_center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/clock_align_center" /><RadioButton android:id="@+id/align_end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/clock_align_end" /></RadioGroup>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" android:background="@drawable/config_button_bar_bg" android:orientation="horizontal"><TextView android:id="@+id/clock_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="36dp" android:paddingVertical="16dp" android:text="@string/clock_cancel" /><TextView android:id="@+id/clock_save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="36dp" android:paddingVertical="16dp" android:text="@string/clock_save" /></LinearLayout>
    </LinearLayout>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
