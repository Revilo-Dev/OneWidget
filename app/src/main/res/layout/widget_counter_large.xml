<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_clock_background" android:gravity="center" android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/counter_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="38sp" android:textStyle="bold" />
    <TextView android:id="@+id/counter_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="13sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginTop="12dp" android:orientation="horizontal">
        <ImageView android:id="@+id/counter_minus" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/widget_round_button" android:contentDescription="Decrease count" android:padding="9dp" />
        <ImageView android:id="@+id/counter_plus" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="12dp" android:background="@drawable/widget_round_button" android:contentDescription="Increase count" android:padding="8dp" />
    </LinearLayout>
</LinearLayout>
