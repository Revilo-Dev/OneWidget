<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the blank widget's native One UI Home blur surface exactly. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66FFFFFF">
    <ImageView android:id="@+id/toggle_circle" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
    <ImageView android:id="@+id/toggle_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/flashlight" android:contentDescription="@null" />
</FrameLayout>
