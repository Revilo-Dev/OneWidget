<?xml version="1.0" encoding="utf-8"?>
<!-- Studio-only RemoteViews geometry layout. Keep the blur root identical to production. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background">

    <FrameLayout
        android:id="@+id/clock_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/clock_time_wrapper"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="center">

            <TextClock
                android:id="@+id/clock_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/samsung_number_default_bold"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:gravity="center"
                android:textColor="#FFFFFFFF"
                android:textSize="42sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/clock_date_wrapper"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="center">

            <TextClock
                android:id="@+id/clock_date_above"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/samsung_number_default_bold"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:gravity="center"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextClock
                android:id="@+id/clock_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/samsung_number_default_bold"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:gravity="center"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/clock_day_wrapper"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <TextClock
                android:id="@+id/clock_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/samsung_number_default_bold"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:gravity="center"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/clock_battery_wrapper"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/clock_battery"
                tools:ignore="UseCompoundDrawables,UselessParent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/clock_battery_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/clock_phone_battery"
                    android:src="@drawable/ic_widget_battery" />

                <TextView
                    android:id="@+id/clock_battery_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/clock_debug_marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
