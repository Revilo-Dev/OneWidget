<?xml version="1.0" encoding="utf-8"?>
<!-- The root ID and translucent background are required by Samsung One UI Home blur. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background">
    <LinearLayout android:id="@+id/clock_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical" android:paddingHorizontal="26dp" android:paddingVertical="18dp">
        <TextClock android:id="@+id/clock_date_above" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredericka_the_great" android:format12Hour="MMMM d, yyyy" android:format24Hour="MMMM d, yyyy" android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="16sp" android:visibility="gone" />
        <TextClock android:id="@+id/clock_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredericka_the_great" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="52sp" android:textStyle="bold" />
        <TextClock android:id="@+id/clock_day" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredericka_the_great" android:format12Hour="EEEE" android:format24Hour="EEEE" android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="16sp" />
        <TextClock android:id="@+id/clock_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/fredericka_the_great" android:format12Hour="MMMM d, yyyy" android:format24Hour="MMMM d, yyyy" android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
