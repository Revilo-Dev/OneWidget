<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/todo_item_row" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/todo_item_check" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Mark complete" android:src="@drawable/checkbox_unchecked" />
    <TextView android:id="@+id/todo_item_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="14sp" />
    <ImageView android:id="@+id/todo_item_delete" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Delete todo" android:padding="4dp" android:src="@drawable/delete_outline" />
</LinearLayout>
