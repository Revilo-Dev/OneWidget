<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">
    <ImageView android:id="@+id/hydration_icon" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="@null" />
    <TextView android:id="@+id/hydration_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textColor="#FFFFFFFF" android:textSize="26sp" android:textStyle="bold" />
    <ImageView android:id="@+id/hydration_minus" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/widget_round_button" android:contentDescription="Remove a glass" android:padding="7dp" />
    <ImageView android:id="@+id/hydration_plus" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/widget_round_button" android:contentDescription="Add a glass" android:padding="6dp" />
    <TextView android:id="@+id/hydration_goal" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
