<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <dev.revilodev.onewidget.ui.FlowToolbarLayout
        android:id="@+id/main_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:expanded="true"
        app:toolbarGravity="top"
        app:title="@string/app_name">

        <dev.revilodev.onewidget.ui.FlowScrollView
            android:id="@+id/widget_picker_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="96dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_location="main_content">

            <LinearLayout
                android:id="@+id/widget_picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="16dp"
                android:paddingEnd="10dp" />
        </dev.revilodev.onewidget.ui.FlowScrollView>
    </dev.revilodev.onewidget.ui.FlowToolbarLayout>

    <dev.revilodev.onewidget.ui.WidgetSearchBar
        android:id="@+id/widget_search"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="10dp" />
</FrameLayout>
