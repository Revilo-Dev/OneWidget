<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background"
    android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
    <LinearLayout android:id="@+id/battery_row_1"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginVertical="2dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/battery_icon_1" android:layout_width="24dp" android:layout_height="18dp" android:layout_marginEnd="10dp" android:contentDescription="@null" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/battery_bar_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
            <TextView android:id="@+id/battery_label_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFFFF" android:textStyle="bold" />
            <ImageView android:id="@+id/battery_charge_1" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/battery_row_2"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginVertical="2dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/battery_icon_2" android:layout_width="24dp" android:layout_height="18dp" android:layout_marginEnd="10dp" android:contentDescription="@null" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/battery_bar_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
            <TextView android:id="@+id/battery_label_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFFFF" android:textStyle="bold" />
            <ImageView android:id="@+id/battery_charge_2" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/battery_row_3"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginVertical="2dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/battery_icon_3" android:layout_width="24dp" android:layout_height="18dp" android:layout_marginEnd="10dp" android:contentDescription="@null" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/battery_bar_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
            <TextView android:id="@+id/battery_label_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFFFF" android:textStyle="bold" />
            <ImageView android:id="@+id/battery_charge_3" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/battery_row_4"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginVertical="2dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/battery_icon_4" android:layout_width="24dp" android:layout_height="18dp" android:layout_marginEnd="10dp" android:contentDescription="@null" />
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/battery_bar_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" />
            <TextView android:id="@+id/battery_label_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFFFF" android:textStyle="bold" />
            <ImageView android:id="@+id/battery_charge_4" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:visibility="gone" android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
