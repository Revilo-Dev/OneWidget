<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/battery_percentage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#FFFFFFFF" android:textSize="46sp" android:textStyle="bold" />
        <TextView android:id="@+id/battery_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="#E6FFFFFF" android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
