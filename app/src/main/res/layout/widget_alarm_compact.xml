<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_clock_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
    <ImageView android:id="@+id/alarm_toggle" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="Enable or disable alarm" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/alarm_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/alarm_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E6FFFFFF" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/alarm_snooze" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
