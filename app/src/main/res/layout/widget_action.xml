<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the blank widget's native One UI Home blur surface exactly. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:padding="14dp">
        <ImageView android:id="@+id/action_icon" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/phone" android:contentDescription="@null" />
        <TextView android:id="@+id/action_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Action" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
