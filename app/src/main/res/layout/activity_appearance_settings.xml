<?xml version="1.0" encoding="utf-8"?>
<dev.oneuiproject.oneui.layout.ToolbarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" app:title="Widget appearance">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" app:layout_location="main_content">
        <dev.oneuiproject.oneui.widget.Separator android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Global effects" />
        <dev.oneuiproject.oneui.widget.SwitchItemView android:id="@+id/global_borders" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="Widget borders" app:summary="Thin translucent outlines around widgets" />
        <dev.oneuiproject.oneui.widget.SwitchItemView android:id="@+id/global_gradients" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="Flowing progress gradients" app:summary="Animate charge, storage, and memory bars" />
    </LinearLayout>
</dev.oneuiproject.oneui.layout.ToolbarLayout>
