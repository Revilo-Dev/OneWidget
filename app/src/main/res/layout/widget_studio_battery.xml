<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background">

    <FrameLayout
        android:id="@+id/battery_progress_wrapper"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="center">
        <ImageView
            android:id="@+id/battery_compact_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/battery_percentage_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <TextView
            android:id="@+id/battery_percentage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            tools:text="72%"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/battery_status_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">
        <TextView
            android:id="@+id/battery_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            tools:text="Charging"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/battery_icon_wrapper"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center">
        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
