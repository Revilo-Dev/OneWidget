<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clock_background">

    <TextView
        android:id="@+id/counter_value"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/counter_minus"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/widget_round_button"
        android:contentDescription="Decrease count"
        android:padding="6dp" />

    <ImageView
        android:id="@+id/counter_plus"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="5dp"
        android:background="@drawable/widget_round_button"
        android:contentDescription="Increase count"
        android:padding="6dp" />

    <TextView
        android:id="@+id/counter_reset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
