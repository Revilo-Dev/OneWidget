<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:initialLayout="@layout/widget_blur"
    android:previewLayout="@layout/widget_preview_large"
    android:minWidth="250dp"
    android:minHeight="320dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="320dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="5"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen"
    android:configure="dev.revilodev.onewidget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    app:widgetStyle="colorful" />

