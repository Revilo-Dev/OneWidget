<?xml version="1.0" encoding="utf-8"?>
<!-- Developer-only, size-agnostic One UI Home test surface. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/developer_widget_description"
    android:initialLayout="@layout/widget_developer_placeholder"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="40dp"
    android:previewLayout="@layout/widget_developer_placeholder"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="1"
    android:widgetCategory="home_screen"
    app:previewLayoutExtraLarge="@layout/widget_developer_placeholder"
    app:previewLayoutLarge="@layout/widget_developer_placeholder"
    app:previewLayoutMedium="@layout/widget_developer_placeholder"
    app:previewLayoutSmall="@layout/widget_developer_placeholder"
    app:previewLayoutWideSmall="@layout/widget_developer_placeholder"
    app:widgetSize="small|wideSmall|medium|large|extraLarge|extraLargeLong"
    app:widgetStyle="colorful"
    tools:ignore="UnusedAttribute" />
